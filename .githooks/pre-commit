#!/usr/bin/env bash
# Pre-commit hook: syntax + undefined-name checks on staged Python files,
# and rejection of any staged symlinks.
# Uses only stdlib (py_compile) so it works with no extra installs.
# If ruff is present it also runs the critical F8xx checks.

set -euo pipefail

ERRORS=0

# ── 0. Reject staged symlinks ────────────────────────────────────────────────
SYMLINKS=$(git diff --cached --name-only --diff-filter=ACM | while read -r f; do
    mode=$(git ls-files --stage -- "$f" 2>/dev/null | awk '{print $1}')
    if [[ "$mode" == "120000" ]]; then
        echo "$f"
    fi
done || true)

if [[ -n "$SYMLINKS" ]]; then
    echo "❌ pre-commit: staged symlinks are NOT allowed in this repository:"
    echo "$SYMLINKS" | while read -r s; do echo "  → $s"; done
    echo ""
    echo "Remove them with: git rm --cached <path>"
    ERRORS=$((ERRORS + 1))
fi

# ── 1. Python file checks ────────────────────────────────────────────────────
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [[ -z "$STAGED" && "$ERRORS" -eq 0 ]]; then
    exit 0
elif [[ -z "$STAGED" && "$ERRORS" -gt 0 ]]; then
    echo ""
    echo "❌ pre-commit FAILED — fix the errors above before committing."
    exit 1
fi

echo "🔍 pre-commit: checking staged Python files..."

# ── 1a. Syntax check (py_compile — always available) ─────────────────────────
for f in $STAGED; do
    if ! python3 -m py_compile "$f" 2>&1; then
        echo "  ✗ syntax error in $f"
        ERRORS=$((ERRORS + 1))
    fi
done

# ── 1b. Undefined names + missing imports (ruff F8xx) ────────────────────────
RUFF=""
for candidate in .venv/bin/ruff venv/bin/ruff; do
    if [[ -x "$candidate" ]]; then
        RUFF="$candidate"
        break
    fi
done
if [[ -z "$RUFF" ]] && command -v ruff &>/dev/null; then
    RUFF="ruff"
fi

if [[ -n "$RUFF" ]]; then
    if ! $RUFF check $STAGED --select F401,F811,F821,E9 --quiet; then
        ERRORS=$((ERRORS + 1))
    fi
else
    echo "  ⚠  ruff not found — skipping undefined-name checks (run: pip install ruff)"
fi

# ── 2. Fork stack validation (canonical branch only) ─────────────────────────
# The stack manifest describes the canonical linear stack (`branch:` in stack.yml,
# default `dev`). Feature/PR branches in worktrees intentionally carry in-progress
# and `fixup!` commits that are not yet squashed into the canonical stack, so the
# full-stack invariant is enforced only when committing on the canonical branch.
if [[ -f ".fork/check-stack.py" ]]; then
    # Tolerate optional surrounding quotes, e.g. `branch: dev` or `branch: "dev"`.
    CANONICAL_BRANCH=$(sed -n -E 's/^branch:[[:space:]]*"?([^"[:space:]]+)"?.*$/\1/p' .fork/stack.yml 2>/dev/null | head -1)
    CANONICAL_BRANCH="${CANONICAL_BRANCH:-dev}"
    # `git rev-parse --abbrev-ref HEAD` prints the literal "HEAD" when detached;
    # normalize that (and any empty result) to an empty string so the check below
    # skips validation and the message reads "detached HEAD".
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ "$CURRENT_BRANCH" == "HEAD" ]]; then
        CURRENT_BRANCH=""
    fi

    if [[ "$CURRENT_BRANCH" != "$CANONICAL_BRANCH" ]]; then
        echo "  ⏭  skipping fork stack validation on '${CURRENT_BRANCH:-detached HEAD}' (enforced only on '$CANONICAL_BRANCH')"
    else
        PYTHON=""
        for candidate in .venv/bin/python venv/bin/python; do
            if [[ -x "$candidate" ]]; then
                PYTHON="$candidate"
                break
            fi
        done
        if [[ -z "$PYTHON" ]] && command -v python3 &>/dev/null; then
            PYTHON="python3"
        fi

        if [[ -n "$PYTHON" ]]; then
            if ! $PYTHON .fork/check-stack.py 2>&1; then
                echo "  ✗ .fork/check-stack.py failed"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi

if [[ "$ERRORS" -gt 0 ]]; then
    echo ""
    echo "❌ pre-commit FAILED — fix the errors above before committing."
    exit 1
fi

echo "✅ pre-commit checks passed."
exit 0
